# Copiá este archivo como .env.local y completalo. NUNCA subas .env.local a GitHub.

# Conexión a la base (Supabase → botón Connect → "Transaction pooler", puerto 6543).
# En Vercel, si creás la base desde Storage → Supabase, no hace falta: la integración carga
# POSTGRES_URL sola y la web la lee igual.
# Si la dirección no trae la contraseña (o dice [YOUR-PASSWORD]), ponela aparte acá:
DATABASE_PASSWORD=
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional: conexión directa / "Session pooler" (puerto 5432) para correr las migraciones.
# DIRECT_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Negocio que se muestra cuando el dominio no coincide con ninguno cargado (ej: *.vercel.app)
DEFAULT_BUSINESS_SLUG=bunker

# Clave del servidor para guardar la huella (no el número) del teléfono de quien borra su cuenta,
# así el 20% de invitación no se repite. En tu PC puede quedar vacía. En Vercel ya está cargada.
APP_SECRET=

# Tiempo real (opcional). Si no están, la web se actualiza sola cada 15 segundos.
# Supabase → Project Settings → API: "Project URL" y la clave "anon public".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: conexión directa / "Session pooler" se usa también en Vercel para crear las tablas.

# Claves iniciales, solo para la primera carga (`npm run db:seed` o la primera publicación en Vercel).
# En tu PC: si no las ponés, se generan al azar y se muestran UNA vez en la terminal.
# En Vercel: son obligatorias (claves de 8+ caracteres, códigos de 4+ números).
ADMIN_USER=admin
ADMIN_PASSWORD=
OWNER_USER=bunker
OWNER_PASSWORD=
MAURI_CODE=
IVAN_CODE=
# Dominio de Bunker (cuando lo tengan), ej: bunkerbarberclub.com.ar
SEED_DOMAIN=
