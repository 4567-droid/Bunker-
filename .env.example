# Copiá este archivo como .env.local y completalo. NUNCA subas .env.local a GitHub.

# Conexión a la base (Supabase → Project Settings → Database → Connection string).
# Para Vercel usá la del "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional: conexión directa / "Session pooler" (puerto 5432) para correr las migraciones.
# DIRECT_URL=postgresql://postgres.TU-PROYECTO:TU-CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Negocio que se muestra cuando el dominio no coincide con ninguno cargado (ej: *.vercel.app)
DEFAULT_BUSINESS_SLUG=bunker

# Tiempo real (opcional). Si no están, la web se actualiza sola cada 15 segundos.
# Supabase → Project Settings → API: "Project URL" y la clave "anon public".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para `npm run db:seed` (primera carga). Si no los ponés, se generan claves al azar
# y se muestran UNA vez en la terminal.
ADMIN_USER=admin
ADMIN_PASSWORD=
OWNER_USER=bunker
OWNER_PASSWORD=
MAURI_CODE=
IVAN_CODE=
# Dominio de Bunker (cuando lo tengan), ej: bunkerbarberclub.com.ar
SEED_DOMAIN=
